{
  "name": "mineserver",
  "version": "1.0.0",
  "description": "Minecraft Server Manager",
  "main": "electron/main.js",
  "scripts": {
    "start": "webpack --mode development && electron .",
    "build": "webpack --mode production",
    "build:web": "webpack --config webpack.config.web.js --mode production",
    "electron": "electron .",
    "pack": "webpack --mode production && electron-builder --win",
    "dev": "webpack --mode development --watch",
    "dev:web": "webpack --config webpack.config.web.js --mode development --watch",
    "deploy": "npm run build:web && npx gh-pages -d build-web"
  },
  "build": {
    "appId": "com.mineserver.app",
    "productName": "MineServer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "build/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "css-loader": "^6.8.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "archiver": "^6.0.0",
    "extract-zip": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
